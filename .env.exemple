# Paramètres conteneur
VISIOS_SANDBOX_IMAGE=visios-sandbox:local
VISIOS_SANDBOX_BASE_IMAGE=tutanka01/agentic:osbase
VISIOS_SANDBOX_NAME=visios-sandbox
VISIOS_SANDBOX_PORT=6901
VISIOS_SANDBOX_WIDTH=1600
VISIOS_SANDBOX_HEIGHT=900
VISIOS_SANDBOX_PLATFORM=linux/amd64
VISIOS_VNC_PASSWORD=password

# Endpoints et modèles IA
VISIOS_OLLAMA_URL=http://host.docker.internal:1234
VISIOS_OLLAMA_MODEL=qwen/qwen2.5-vl-7b
VISIOS_OLLAMA_TEMPERATURE=0.1
VISIOS_OLLAMA_TIMEOUT=120
VISIOS_API_MODE=openai
VISIOS_OPENAI_ENDPOINT=chat_completions
VISIOS_AGENT_MAX_STEPS=3
VISIOS_ACTION_DELAY=1.0
VISIOS_REPEAT_TOLERANCE=2
VISIOS_SAFETY_MODE=balanced
VISIOS_TRAJECTORY_DIR=trajectories
VISIOS_SAVE_SCREENSHOTS=true
VISIOS_INPUT_BACKEND=xdotool
VISIOS_VNC_HOST=127.0.0.1
VISIOS_VNC_PORT=5901

# Interface
VISIOS_IFRAME_URL=http://localhost:6901/vnc_lite.html
VISIOS_IFRAME_HEIGHT=78vh
